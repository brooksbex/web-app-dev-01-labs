<form class="ui stacked segmet form" action="/playlist/{{id}}/addsong" method="POST">
    <div class="two fields">
        <div class="field">
            <label>Title</label>
            <input type="text" name="title" autofocus required title="Please include a valid title" placeholder="Title">
        </div>
        <div class="field">
            <label>Artist</label>
            <input type="text" name="artist" required title="Please include a valid artist" placeholder="Artist">
        </div>
    </div>
    <button class="ui blue submit button">Add Song</button>
</form>
<form class="ui stacked segment form" action="/dashboard/addplaylist" method="post" enctype="multipart/form-data">
    <div class="three fields">
    <div class="field">
        <label for="title">Title</label>
        <input placeholder="Title" type="text" name="title" title="Please enter a valid title!" autofocus required>
    </div>
    <div class="field">
        <label for="rating">Rating</label>
        <input placeholder="Rating" type="number" name="rating" min="1" max="5" title="Please enter a rating!" required>
    </div>
    <div class="field">
        <label for="picture">Image</label>
        <input placeholder="Image" type="file" name="picture" required>
    </div>
    </div>
    <button class="ui blue submit button">Add Playlist</button>
</form>